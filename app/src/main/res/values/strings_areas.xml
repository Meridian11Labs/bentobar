<?xml version="1.0" encoding="utf-8"?>
<!-- The bar's three areas, as the item detail, the rows and Look's Position row name them. Every name here starts with areas_. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="areas_label">Area</string>
    <string name="areas_left">Left</string>
    <string name="areas_middle">Middle</string>
    <string name="areas_right">Right</string>
    <string name="areas_look_several">Items are in several areas. Choosing one moves them all there.</string>
    <!-- The Bar page with areas. "Add an area" opens a menu of the areas not on screen, each with where it stands in the bar. -->
    <string name="areas_add">Add an area</string>
    <string name="areas_left_where">After the clock</string>
    <string name="areas_middle_where">Centered in the free space</string>
    <string name="areas_right_where">Next to the system icons</string>
    <!-- An area's + in the narrow list, read out: "Add an item to Left". -->
    <string name="areas_add_item">Add an item to %1$s</string>
    <!-- An area just added that has nothing in it yet; %1$s is its name. Read out, with the keys that move an item there ("Alt+←"). -->
    <string name="areas_empty_new">Nothing here yet. Drag an item here, or choose %1$s as an item\'s Area. An empty area takes no room in the bar.</string>
    <string name="areas_empty_new_spoken">%1$s, empty. Move an item here with %2$s.</string>
    <!-- An area's lower part with nothing in it. -->
    <string name="areas_nothing">Nothing here</string>
    <!-- An area whose last item left: it is gone from the page, with Undo beside these words. -->
    <string name="areas_folded">%1$s is empty now, so it closed.</string>
    <!-- On the row that left it. -->
    <string name="areas_moved">Moved</string>
    <!-- A screen reader's action on a row: "Move to Left". -->
    <string name="areas_move_to">Move to %1$s</string>
    <!-- The library's choice of the area its + adds to. -->
    <string name="areas_add_to">Add to</string>
    <!-- An area the bar has no room for right now; %1$s (and %2$s) are the areas that come first, the last one the area itself. -->
    <string name="areas_no_room_one">No room right now. %1$s takes the free space first. %2$s comes back when there is room.</string>
    <string name="areas_no_room_two">No room right now. %1$s and %2$s take the free space first. %3$s comes back when there is room.</string>
    <!-- In the preview, in the place of an area the bar has no room for. -->
    <string name="areas_system_now">Used by the system right now</string>
</resources>
