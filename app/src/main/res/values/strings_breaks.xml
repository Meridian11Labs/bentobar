<?xml version="1.0" encoding="utf-8"?>
<!-- Break reminder. Every name here starts with breaks_, item_breaks_ or trigger_breaks. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <string name="item_breaks_title">Break reminder</string>
    <string name="item_breaks_desc">The time until your next break, counted while the screen is on</string>
    <string name="trigger_breaks">while a break is due</string>
    <string name="trigger_breaks_short">shows when a break is due</string>
    <!-- The bar's time until the next break: "38 min", "1 h 20" (hours, then minutes in two figures). -->
    <!-- The bar's word when one is due. -->
    <string name="breaks_due">Break</string>
