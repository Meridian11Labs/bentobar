    <string name="breaks_note">A break is %1$d min with the screen off or BentoBar hidden. Only that is counted: not the keyboard, the mouse or what is on screen.</string>
    <string name="breaks_took_one">I took one</string>
    <string name="breaks_every">A break every</string>
    <string name="breaks_rest">A break lasts</string>
